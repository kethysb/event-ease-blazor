@page "/events/{Id:int}"
@using EventEase.Models
@using EventEase.Services
@inject EventService EventService
@inject NavigationManager Nav

@if (ev is null)
{
    <div class="alert alert-danger mt-3">
        <h4>Event Not Found</h4>
        <a href="/events" class="btn btn-secondary">Back to Events</a>
    </div>
}
else
{
    <div class="card mt-3 p-4">
        <h2>@ev.Name</h2>
        <p class="text-muted">@ev.Date.ToString("dddd, MMMM dd, yyyy") | @ev.Location</p>
        <p>@ev.Description</p>
        <p><strong>Availability:</strong> @(ev.Capacity - ev.RegisteredCount) seats remaining</p>
        <div class="d-flex gap-2">
            <button class="btn btn-success" @onclick='() => Nav.NavigateTo($"/register/{ev.Id}")'>Proceed to Registration</button>
            <a class="btn btn-outline-secondary" href="/events">Back</a>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private EventModel? ev;

    protected override async Task OnParametersSetAsync()
    {
        ev = await EventService.GetEventByIdAsync(Id);
    }
}
